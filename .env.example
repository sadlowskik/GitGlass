# Copy to .env for local dev. NEVER commit the real .env.
# The GitHub OAuth *client id* is not a secret (device flow uses no client secret).
# It is only needed starting in Milestone 4.
VITE_GITHUB_CLIENT_ID=

# Updater public key is baked into tauri.conf.json at build time; the PRIVATE key
# lives only in CI secrets (TAURI_SIGNING_PRIVATE_KEY). Never place it here.
